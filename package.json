{
  "name": "marketing-workflow-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "uv run uvicorn server:app --app-dir scripts --host 127.0.0.1 --port 4187 --reload",
    "dev:web": "next dev --hostname 127.0.0.1 --port 4186",
    "build": "next build",
    "start": "concurrently --kill-others --names api,web \"npm:start:api\" \"npm:start:web\"",
    "start:api": "uv run uvicorn server:app --app-dir scripts --host 127.0.0.1 --port 4187",
    "start:web": "next start --hostname 127.0.0.1 --port 4186",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:web && npm run test:api",
    "test:web": "tsx --test tests/*.test.tsx",
    "test:api": "uv run python -m unittest discover -s tests -p 'test_*.py'"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "keycloak-js": "^26.2.4",
    "lucide-react": "^0.577.0",
    "next": "16.4.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
