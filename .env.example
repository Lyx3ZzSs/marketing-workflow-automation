# Next.js server-side proxy target (no credentials here).
API_BASE_URL=http://127.0.0.1:4187

# Public browser configuration. Never add a client secret to NEXT_PUBLIC_*.
NEXT_PUBLIC_KEYCLOAK_URL=http://10.8.6.32:18080
NEXT_PUBLIC_KEYCLOAK_REALM=company-dev
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=marketing-workflow-automation-web
NEXT_PUBLIC_KEYCLOAK_REDIRECT_URI=http://127.0.0.1:4186/callback
NEXT_PUBLIC_KEYCLOAK_LOGOUT_REDIRECT_URI=http://127.0.0.1:4186/

# Backend access-token verification; no client secret is required for JWKS.
KEYCLOAK_ISSUER=http://10.8.6.32:18080/realms/company-dev
KEYCLOAK_JWKS_URL=http://10.8.6.32:18080/realms/company-dev/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=marketing-workflow-automation-api

# FastAPI: export these in the shell, or pass --env-file to uvicorn.
# Existing local-data/*.json settings remain supported.
# LEDGER_CREDENTIALS_DOC=/absolute/path/to/document.docx
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=
